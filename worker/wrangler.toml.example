name = "samsons-timeclock-api"
main = "worker.js"
compatibility_date = "2026-09-20"

[vars]
ALLOWED_ORIGINS = "https://samsonsautomation.github.io,http://localhost:5500,http://127.0.0.1:5500"
SESSION_HOURS = "12"
# Use "sandbox" while developing. Switch to "live" only after PayPal/Venmo vaulting is approved and tested.
PAYPAL_ENV = "sandbox"

# Runs hourly. The job only charges subscriptions whose next_charge_at is due.
[triggers]
crons = ["17 * * * *"]

[[d1_databases]]
binding = "DB"
database_name = "samsons-timeclock"
database_id = "YOUR_DATABASE_ID"
